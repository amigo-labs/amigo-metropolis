{
  "name": "amigo-metropolis",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter @metropolis/client dev",
    "gen:units": "bun run tools/generators/genUnitModels.ts",
    "gen:sfx": "bun run tools/generators/genSfx.ts",
    "gen:mapalign": "bun run tools/generators/genMapAlign.ts",
    "gen:palogic": "bun run tools/generators/fcopLogic.ts",
    "gen:walls": "bun run tools/generators/fcopWalls.ts",
    "gen:arena": "bun run tools/generators/enrichArena.ts",
    "replay:record:all": "bun run tools/determinism/src/recordAll.ts",
    "replay:verify": "bun run tools/determinism/src/cli.ts verify-goldens",
    "replay:verify:browser": "bun run tools/determinism/src/browserVerify.ts",
    "e2e:touch": "bun run tools/determinism/src/touchInput.ts",
    "verify:arenas": "bun run tools/determinism/src/arenaShots.ts",
    "verify:units": "bun run tools/determinism/src/unitShots.ts",
    "pin:serve": "bun run tools/determinism/src/pinServer.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
