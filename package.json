{
  "name": "amigo-metropolis",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter @metropolis/client build",
    "build:worker": "bun run --filter @metropolis/server build",
    "ensure-client-dist": "bun run tools/ensureClientDist.ts",
    "dev": "bun run --filter @metropolis/client dev",
    "gen:units": "bun run tools/generators/genUnitModels.ts",
    "gen:sfx": "bun run tools/generators/genSfx.ts",
    "gen:frontend": "bun run tools/generators/importFcopFrontend.ts",
    "gen:movies": "bun run tools/generators/importFcopMovies.ts",
    "gen:results": "bun run tools/generators/importFcopResults.ts",
    "gen:fxsheet": "bun run tools/generators/fx/particleSheet.ts",
    "gen:fx": "bun run tools/generators/fcopEffects.ts",
    "gen:fxcobj": "bun run tools/generators/fx/cobjContact.ts",
    "gen:mapalign": "bun run tools/generators/genMapAlign.ts",
    "gen:palogic": "bun run tools/generators/fcopLogic.ts",
    "gen:parules": "bun run tools/generators/fcopRules.ts",
    "gen:pamodels": "bun run tools/generators/fcopModels.ts",
    "gen:paprops": "bun run tools/generators/fcopPaProps.ts",
    "gen:scenery": "bun run tools/generators/fcopScenery.ts",
    "gen:paunits": "bun run tools/generators/fcopUnits.ts",
    "gen:x1": "bun run tools/generators/fcopX1.ts",
    "gen:walls": "bun run tools/generators/fcopWalls.ts",
    "gen:arena": "bun run tools/generators/enrichArena.ts",
    "gen:coarse": "bun run tools/generators/fcopCoarse.ts",
    "gen:presentation": "bun run tools/generators/importFcopPresentation.ts",
    "gen:pads": "bun run tools/generators/stampPads.ts",
    "replay:record:all": "bun run tools/determinism/src/recordAll.ts",
    "replay:verify": "bun run tools/determinism/src/cli.ts verify-goldens",
    "replay:verify:browser": "bun run tools/determinism/src/browserVerify.ts",
    "verify:arenas": "bun run tools/determinism/src/arenaShots.ts",
    "verify:units": "bun run tools/determinism/src/unitShots.ts",
    "verify:x1": "bun run tools/determinism/src/x1Shots.ts",
    "verify:weapons": "bun run tools/determinism/src/weaponShots.ts",
    "pin:serve": "bun run tools/determinism/src/pinServer.ts",
    "pin:drive": "bun run tools/determinism/src/pinDrive.ts",
    "pin:cmd": "bun run tools/determinism/src/pinCmd.ts",
    "balance:pa": "bun run tools/balance/src/paResolve.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.108.0"
  }
}
