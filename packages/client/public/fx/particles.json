 "palette_format": "A1R5G5B5: red bits 10..14, green 5..9, blue 0..4, bit 15 a flag (see alpha)",
 "palette_levels": {
  "levels": 64,
  "neutral": 32,
  "rule": "level L of word w: each 5-bit channel c becomes min(31, (c * L + 16) >> 5), bit 15 kept (palette_shade, src/game/res/palette.c); L = 0x20 is w itself",
  "drawn_level": "the drawer binds level 0x20 (cpyr_publish); the PNGs are that level"
 },
 "alpha": {
  "key": "the palette word 0 is transparent -- every palette's entry 0 and its only zero word; PNG alpha 0",
  "bit15": "set in every non-zero word of all eight palettes. The software renderer averages such a texel 50/50 with the frame buffer when the record has the half-alpha op bit and blend byte 1 (pyro flag 0x02, see draw.modes); the ARGB4444 hardware surface stores it as alpha 8 of 15 and the ARGB1555 one stores it inverted (video_encode_4444 / video_encode_1555, src/game/video/texture.c), whose use by the driver is not established. Additive and subtractive records do not read it",
  "png": "alpha 255 for every other texel: apply the 50 % in the blend when the particle is drawn translucent"
 },
 "draw": {
  "source": "pyro_draw_instance 0x004373e0 (src/game/world/pyro_draw.c) builds one display-list record per live particle; draw_submit_thrash 0x00456270 (src/game/video/draw_submit.c) and the software routines of fcop/draw_poly.h and fcop/render_poly.h consume it",
  "texture": "Cpyr atlas page = texture slot 11 + page; the corners take (u, v), (u+w-1, v), (u+w-1, v+h-1), (u, v+h-1), byte arithmetic",
  "geometry": "the particle's pyro flags (fcop/pyro_chain.h). 0x04 (BOX): a screen-facing sprite; the record's span s (world units) is the side of a size_pow2 x size_pow2 cell centred on the point and the sprite rect sits at (off_x, off_y)..(off_x+w, off_y+h) in it, scaled by s / size_pow2. 0x04 with 0x08 (HEADING): the rect is instead centred, half-extents (w/2, h/2) at the same scale, turned by the heading. 0x04 clear: a world quad of the four corners turned by the three angles, back-face culled unless 0x01 (TWO_SIDED). A type-93 node's span is max(instance +0x12 << 5, 0x500); fcop/actor_effect_type93.h",
  "vertex_colour": "vertex 0 = the particle's colour (r, g, b bytes; 0x80 is 1.0, the submitter doubles them and clamps at 0xff); the submitter colours all four vertices from vertex 0",
  "frame": "sprite = ((clock - born) / frame_ticks) % frames (two signed divides); every shipped particle has one sprite, so it is always 0",
  "modes": [
   {
    "pyro_flags": "none of 0x02, 0x10, 0x20",
    "op": 132,
    "blend_byte": 1,
    "thrash_blend_states": [
     2,
     3
    ],
    "reads": "opaque texture, vertex colour ignored: colour mode 0x00 on a textured record forces grey 0x80, doubled to white (draw_submit.c colour_of); software mode 2, a plain copy with texel 0 transparent"
   },
   {
    "pyro_flags": "0x02",
    "op": 140,
    "blend_byte": 1,
    "thrash_blend_states": [
     2,
     3
    ],
    "reads": "translucent texture, vertex colour ignored (white as above); software mode 3 averages every texel whose palette word carries bit 15 50/50 with the frame buffer -- every non-zero word of all eight palettes does, so the whole sprite is a 50 % blend"
   },
   {
    "pyro_flags": "0x10",
    "op": 188,
    "blend_byte": 2,
    "thrash_blend_states": [
     0,
     0
    ],
    "reads": "additive: texel times the vertex colour doubled (clamped at 0xff) added to the frame buffer, saturating; a record whose doubled colour overflowed is submitted twice; software mode 6 (texel channels through the vertex shade, added)"
   },
   {
    "pyro_flags": "0x20 without 0x10",
    "op": 188,
    "blend_byte": 3,
    "thrash_blend_states": [
     1,
     8
    ],
    "reads": "subtractive: texel times the vertex colour subtracted from the frame buffer, floored at 0; THRASH colours it rgb x 4 through the `shr` defect draw_submit.c rgb_times_four names; software mode 7"
   }
  ],
  "thrash_states": "the pair sent to THRASH states 0x194 and 0x195 is measured (draw_submit.c blend_sync); what a driver makes of the numbers is not established. The average / add / subtract reading of blend bytes 1 / 2 / 3 is the software renderer's, which takes the same record"
 },
